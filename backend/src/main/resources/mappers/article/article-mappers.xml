<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yachaerang.backend.api.article.repository.ArticleMapper">
    <!-- Article Entity -->
    <resultMap id="articleResultMap"
               type="com.yachaerang.backend.api.article.entity.Article">
        <id property="id" column="article_id"/>
        <result property="title" column="title" javaType="String"/>
        <result property="content" column="content" javaType="String"/>
        <result property="contentHash" column="content_hash" javaType="String"/>
        <result property="imageUrl" column="image_url" javaType="String"/>
        <result property="imageMap" column="image_map"
                typeHandler="com.yachaerang.backend.global.util.JsonTypeHandler"/>
        <result property="imageCount" column="image_count" javaType="int"/>
        <result property="url" column="url" javaType="String"/>
        <result property="sourceHost" column="source_host" javaType="String"/>
        <result property="fetchedAt" column="fetched_at" javaType="java.time.LocalDateTime"/>
        <result property="status" column="status"
                javaType="com.yachaerang.backend.api.article.entity.Article$Status"
                typeHandler="org.apache.ibatis.type.EnumTypeHandler"/>
        <result property="errorMessage" column="error_message" javaType="String"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <!-- 1:N 관계 매핑 -->
        <collection property="tagList"
                    ofType="com.yachaerang.backend.api.article.entity.Tag">
            <id property="id" column="tag_id"/>
            <result property="name" column="name"/>
            <result property="articleId" column="article_id"/>
        </collection>
    </resultMap>

    <!-- findAllWithPagination -->
    <select id="findAllWithPagination" resultMap="articleResultMap">
        SELECT *
        FROM article
        ORDER BY created_at DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <!-- countAll -->
    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM article
    </select>

    <!-- findById -->
    <select id="findById" resultMap="articleResultMap">
        SELECT *
        FROM article
        WHERE article_id = #{id}
    </select>

    <!-- findByKeyword -->
    <select id="findByKeyword" resultMap="articleResultMap">
        SELECT DISTINCT a.*
        FROM article a
            LEFT JOIN tag t ON a.article_id = t.article_id
        WHERE a.title LIKE CONCAT('%', #{keyword}, '%')
           OR t.name LIKE CONCAT('%', #{keyword}, '%')
        ORDER BY a.created_at DESC
            LIMIT #{limit} OFFSET #{offset}
    </select>

    <!-- countByKeyword -->
    <select id="countByKeyword" resultType="long">
        SELECT COUNT(DISTINCT a.article_id)
        FROM article a
            LEFT JOIN tag t ON a.article_id = t.article_id
        WHERE a.title LIKE CONCAT('%', #{keyword}, '%')
           OR t.name LIKE CONCAT('%', #{keyword}, '%')
    </select>
</mapper>